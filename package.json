{
  "name": "ts-coverage-demo",
  "version": "0.0.1",
  "private": true,
  "description": "Tiny TypeScript playground used as the demo target for the Coverage Improver. Has one well-tested file and several uncovered ones — perfect for showing the full clone → AI → PR flow.",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=lcovonly"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.test\\.ts$",
    "collectCoverageFrom": ["src/**/*.ts"],
    "coverageDirectory": "coverage"
  }
}
